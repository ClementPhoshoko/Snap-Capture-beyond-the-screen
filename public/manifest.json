{
  "manifest_version": 3,
  "name": "AkovoLabs Snap",
  "version": "1.2.0",
  "author": "Clement Phoshoko",
  "description": "Capture full-page screenshots and extract any webpage into a ready-to-run React project with AI.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "optional_host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
