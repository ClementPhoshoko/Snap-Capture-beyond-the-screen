{
  "manifest_version": 3,
  "name": "AkovoLabs Snap",
  "version": "1.1.0",
  "description": "Capture visible areas and complete web pages as images.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "tabs", "scripting", "storage", "downloads"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
