{
  "manifest_version": 3,
  "name": "AkovoLabs Snap",
  "version": "1.0.0",
  "description": "Capture beyond the screen. A modern Chrome Extension for full-page scrolling screenshots.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["messages.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
